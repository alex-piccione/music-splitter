{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🏗️ Setup Project",
      "type": "shell",
      "command": "uv venv .venv --python 3.14 && uv pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "🚀 Run Music-Splitter",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/main.py"],
      "cwd": "${workspaceFolder}",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🧪 Run Tests",
      "type": "shell",
      "command": "python -m unittest discover tests",
      "cwd": "${workspaceFolder}",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
